{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rathole-manage",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "rathole.qwe7002.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATHOLE_HUB",
        "class_name": "RatholeHub"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "rathole-manage-status",
      "database_id": "75c19681-0af3-48f8-9558-b32c963d1454",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RatholeHub"]
    }
  ],
  // Second deployment on the reallsys Cloudflare account. Bindings do not
  // inherit into environments, so every account-scoped resource is repeated.
  // Build + deploy with:
  //   CLOUDFLARE_ENV=reallsys npm run build && npx wrangler deploy --profile reallsys
  "env": {
    "reallsys": {
      "name": "rathole-manage",
      "routes": [
        {
          "pattern": "rathole.reall.icu",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "RATHOLE_HUB",
            "class_name": "RatholeHub"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "STATUS_DB",
          "database_name": "rathole-manage-status",
          "database_id": "538618c1-140b-47ca-9505-6fdaab78d084",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
