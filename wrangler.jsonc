{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rathole-manage",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "rathole.qwe7002.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATHOLE_HUB",
        "class_name": "RatholeHub"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "rathole-manage-status",
      "database_id": "75c19681-0af3-48f8-9558-b32c963d1454",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RatholeHub"]
    }
  ]
}
